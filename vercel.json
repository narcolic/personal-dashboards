{
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/portfolio-snapshot", "schedule": "0 21 * * *" },
    { "path": "/api/portfolio-snapshot", "schedule": "0 22 * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
